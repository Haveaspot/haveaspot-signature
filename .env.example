# Vercel Postgres / Neon connection string.
# Vercel injects this automatically in production once a Postgres store is
# connected. The app also accepts DATABASE_URL, STORAGE_URL, POSTGRES_PRISMA_URL
# or POSTGRES_URL_NON_POOLING, since the name depends on the provider and on the
# "custom prefix" chosen when connecting the store.
POSTGRES_URL="postgres://user:pass@host/db?sslmode=require"

# Shared secret guarding /api/cron/expire-campaigns so only Vercel Cron can call it.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Public base URL used to build the absolute image/tracking URLs that get baked
# into the signature HTML. Must be the live domain in production — email clients
# cannot resolve localhost.
PUBLIC_SITE_URL="http://localhost:4326"

# Only addresses on this domain may sync into the CRM (mirrors the PHP
# `@settlin.io` domain guard).
ALLOWED_EMAIL_DOMAIN="haveaspot.com"

# Shared password for the /admin area. Long and random — it is the only thing
# protecting staff contact details and analytics.
# Generate with: openssl rand -base64 24
# Changing it signs everyone out, because session cookies are signed with a key
# derived from it.
ADMIN_PASSWORD=""

# Vercel Blob, for uploaded campaign banners. Set automatically when a Blob
# store is connected to the project. Without it the banner fields still accept a
# URL hosted elsewhere, exactly as the WordPress original did — uploads are the
# only thing that stops working.
BLOB_READ_WRITE_TOKEN=""
