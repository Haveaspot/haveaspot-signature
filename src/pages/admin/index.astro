---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { sql } from '../../lib/db';

export const prerender = false;

/**
 * Admin dashboard — a status overview and the landing page after sign-in.
 *
 * Access is enforced by src/middleware.ts, not here.
 */

interface Counts {
	signatures: number;
	departments: number;
	campaigns: number;
	live_campaigns: number;
	clicks: number;
	clicks_7d: number;
}

let counts: Counts | null = null;
let dbError = '';

try {
	const rows = await sql<Counts[]>`
		SELECT
			(SELECT count(*) FROM signatures)::int   AS signatures,
			(SELECT count(*) FROM departments)::int  AS departments,
			(SELECT count(*) FROM campaigns)::int    AS campaigns,
			(SELECT count(*) FROM campaigns
			  WHERE is_deactivated = false
			    AND starts_at IS NOT NULL AND ends_at IS NOT NULL
			    AND now() BETWEEN starts_at AND ends_at)::int AS live_campaigns,
			(SELECT count(*) FROM clicks)::int       AS clicks,
			(SELECT count(*) FROM clicks
			  WHERE clicked_at > now() - interval '7 days')::int AS clicks_7d
	`;
	counts = rows[0] ?? null;
} catch (error) {
	// Surfaced rather than swallowed: unlike the email-facing routes, an admin
	// looking at a dashboard is far better served by the actual error than by a
	// page that quietly shows zeroes.
	dbError = error instanceof Error ? error.message : String(error);
}

const tiles = [
	{ value: counts?.signatures, label: 'Staff signatures', href: '/admin/signatures' },
	{ value: counts?.departments, label: 'Departments', href: '/admin/departments' },
	{ value: counts?.campaigns, label: 'Campaigns', href: '/admin/campaigns' },
	{ value: counts?.live_campaigns, label: 'Live now', href: '/admin/campaigns' },
	{ value: counts?.clicks_7d, label: 'Clicks, last 7 days', href: '/admin/analytics' },
	{ value: counts?.clicks, label: 'Clicks, all time', href: '/admin/analytics' },
];
---

<AdminLayout title="Dashboard" lede="Staff records, campaigns and click analytics." section="dashboard">
	{
		dbError ? (
			<section class="panel panel--error">
				<h2>Database unavailable</h2>
				<p>The admin area cannot reach Postgres. Nothing below will work until this is fixed.</p>
				<pre class="error-detail">{dbError}</pre>
				<p class="footnote">
					Usually one of: no Postgres store linked to the project, the connection variable
					missing, a deploy that predates it being added, or the schema never applied
					(<code>npm run db:push</code>).
				</p>
			</section>
		) : (
			<>
				<div class="stat-grid">
					{
						tiles.map((tile) => (
							<a class="stat stat--link" href={tile.href}>
								<span class="stat-value">{tile.value ?? 0}</span>
								<span class="stat-label">{tile.label}</span>
							</a>
						))
					}
				</div>

				{counts?.signatures === 0 && (
					<section class="panel">
						<h2>No staff signatures yet</h2>
						<p class="footnote">
							Records are created automatically when someone generates their signature at
							<a href="/"> the generator</a> — there is nothing to add by hand. Send colleagues
							the link and they will appear here.
						</p>
					</section>
				)}
			</>
		)
	}
</AdminLayout>
