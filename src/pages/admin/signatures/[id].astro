---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ImageField from '../../../components/ImageField.astro';
import SignaturePreview from '../../../components/SignaturePreview.astro';
import { resolveCtaConfig } from '../../../lib/campaigns';
import { getSettings } from '../../../lib/settings';
import { env } from '../../../lib/env';
import { listMedia, isConfigured } from '../../../lib/media';
import {
	getSignature,
	listDepartments,
	updateSignatureOverrides,
	setSignatureDepartments,
	deleteSignature,
} from '../../../lib/admin-db';

export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isFinite(id)) return Astro.redirect('/admin/signatures', 302);

let notice = '';
let error = '';

if (Astro.request.method === 'POST') {
	try {
		const form = await Astro.request.formData();

		if (String(form.get('action')) === 'delete') {
			await deleteSignature(id);
			return Astro.redirect('/admin/signatures?deleted=1', 302);
		}

		await updateSignatureOverrides(id, {
			// Absent means off: an unticked checkbox submits nothing at all, so
			// reading presence is the only way a box can ever be unticked again.
			disable_cta: form.get('disable_cta') === '1',
			disable_promo: form.get('disable_promo') === '1',
			promo_only_mode: form.get('promo_only_mode') === '1',
			cta_heading: String(form.get('cta_heading') ?? '').trim().slice(0, 200),
			cta_link: String(form.get('cta_link') ?? '').trim().slice(0, 400),
			btn_text: String(form.get('btn_text') ?? '').trim().slice(0, 60),
			promo_image_url: String(form.get('promo_image_url') ?? '').trim().slice(0, 400),
		});

		await setSignatureDepartments(
			id,
			form.getAll('departments').map(Number).filter(Number.isFinite),
		);

		notice = 'Saved.';
	} catch (err) {
		error = err instanceof Error ? err.message : String(err);
	}
}

let signature: Awaited<ReturnType<typeof getSignature>> = null;
let departments: Awaited<ReturnType<typeof listDepartments>> = [];
let loadError = '';

// Best-effort: the field falls back to a plain URL box if the library cannot be
// read, so a blob problem never blocks editing.
const mediaConfigured = isConfigured();
let media: Awaited<ReturnType<typeof listMedia>> = [];
if (mediaConfigured) {
	try {
		media = await listMedia();
	} catch {
		media = [];
	}
}

try {
	[signature, departments] = await Promise.all([getSignature(id), listDepartments()]);
} catch (err) {
	loadError = err instanceof Error ? err.message : String(err);
}

if (!loadError && !signature) return Astro.redirect('/admin/signatures', 302);

/**
 * Resolved after the POST above, so the preview shows the state just saved
 * rather than the state the page loaded with.
 *
 * Best-effort: a preview is worth having but not worth failing the whole page
 * for, so a problem here leaves it out rather than showing an error.
 */
let previewConfig: Awaited<ReturnType<typeof resolveCtaConfig>> | null = null;
let previewSettings: Awaited<ReturnType<typeof getSettings>> | null = null;

if (signature) {
	try {
		[previewConfig, previewSettings] = await Promise.all([
			resolveCtaConfig(signature.email),
			getSettings(),
		]);
	} catch {
		previewConfig = null;
	}
}

const previewBase = (env('PUBLIC_SITE_URL') ?? Astro.url.origin).replace(/\/$/, '');

const assigned = new Set(
	departments.filter((d) => signature?.department_names.includes(d.name)).map((d) => d.id),
);

const fullName = signature ? `${signature.first_name} ${signature.last_name}`.trim() : '';
---

<AdminLayout
	title={fullName || 'Staff member'}
	lede={signature?.email}
	section="signatures"
>
	<a slot="actions" class="btn btn--secondary btn--small" href="/admin/signatures">← All staff</a>

	{
		loadError ? (
			<section class="panel panel--error">
				<h2>Database unavailable</h2>
				<pre class="error-detail">{loadError}</pre>
			</section>
		) : (
			<>
				{notice && <p class="status status--ok">{notice}</p>}
				{error && <p class="status status--error">{error}</p>}

				{previewConfig && previewSettings && signature && (
					<SignaturePreview
						fields={{
							firstName: signature.first_name,
							lastName: signature.last_name,
							jobTitle: signature.job_title,
							email: signature.email,
							mobile: signature.mobile,
							office: signature.office,
						}}
						config={previewConfig}
						settings={previewSettings}
						baseUrl={previewBase}
					/>
				)}

				<form method="POST">
					<fieldset class="group">
						<legend>Their details</legend>
						<p class="footnote" style="margin-top:0">
							Name, job title, email and phone numbers are not editable here. They belong to
							the person and are refreshed every time they re-run the generator, so an edit
							made here would be silently overwritten. Ask them to regenerate instead.
						</p>
						<table class="data" style="margin-top:1rem">
							<tbody>
								<tr><th>Name</th><td>{fullName || '—'}</td></tr>
								<tr><th>Job title</th><td>{signature?.job_title || <span class="muted">not set</span>}</td></tr>
								<tr><th>Email</th><td>{signature?.email}</td></tr>
								<tr><th>Mobile</th><td>{signature?.mobile || <span class="muted">not set</span>}</td></tr>
								<tr><th>Office</th><td>{signature?.office || <span class="muted">not set</span>}</td></tr>
								<tr>
									<th>LinkedIn</th>
									<td>
										{signature?.linkedin_url ? (
											<a href={signature.linkedin_url} target="_blank" rel="noopener noreferrer">
												{signature.linkedin_url}
											</a>
										) : (
											<span class="muted">not set — the icon points at the company page</span>
										)}
									</td>
								</tr>
								<tr><th>Clicks</th><td>{signature?.click_count}</td></tr>
							</tbody>
						</table>
					</fieldset>

					<fieldset class="group">
						<legend>Departments</legend>
						{departments.length === 0 ? (
							<p class="footnote" style="margin-top:0">
								No departments exist yet. <a href="/admin/departments">Create one</a> to be able
								to target campaigns at groups.
							</p>
						) : (
							departments.map((d) => (
								<label class="check">
									<input
										type="checkbox"
										name="departments"
										value={d.id}
										checked={assigned.has(d.id)}
									/>
									<span>{d.name}</span>
								</label>
							))
						)}
					</fieldset>

					<fieldset class="group">
						<legend>Overrides for this person</legend>
						<p class="footnote" style="margin-top:0">
							Leave blank to use the global settings. A live campaign overrides both.
						</p>

						<label class="check">
							<input type="checkbox" name="disable_cta" value="1" checked={signature?.disable_cta} />
							<span>
								Hide the banner for this person
								<span class="hint">A live campaign will still show — campaigns override this.</span>
							</span>
						</label>

						<label class="check">
							<input type="checkbox" name="promo_only_mode" value="1" checked={signature?.promo_only_mode} />
							<span>Show only the promo image, no heading or button</span>
						</label>

						<label class="check">
							<input type="checkbox" name="disable_promo" value="1" checked={signature?.disable_promo} />
							<span>Never show a promo image for this person</span>
						</label>

						<div class="field">
							<label for="cta_heading">Banner heading</label>
							<input id="cta_heading" name="cta_heading" type="text" value={signature?.cta_heading} />
							<span class="hint">Use | to force a line break.</span>
						</div>

						<div class="field">
							<label for="btn_text">Button label</label>
							<input id="btn_text" name="btn_text" type="text" value={signature?.btn_text} />
						</div>

						<div class="field">
							<label for="cta_link">Button destination</label>
							<input id="cta_link" name="cta_link" type="url" value={signature?.cta_link} />
						</div>

						<ImageField
							name="promo_image_url"
							value={signature?.promo_image_url ?? ''}
							media={media}
							configured={mediaConfigured}
						/>
					</fieldset>

					<div class="form-actions">
						<button type="submit" class="btn">Save</button>
						<a class="btn btn--secondary" href="/admin/signatures">Cancel</a>
					</div>
				</form>

				<form
					method="POST"
					style="margin-top:2.5rem"
					onsubmit={`return confirm('Delete ${fullName}? Their click history is kept but no longer attributed, and their pasted signature will fall back to the global settings.')`}
				>
					<input type="hidden" name="action" value="delete" />
					<button type="submit" class="btn btn--danger btn--small">Delete this staff record</button>
					<span class="footnote" style="display:block; margin-top:.5rem">
						Their signature keeps working — it falls back to the global settings, and the
						record reappears if they use the generator again.
					</span>
				</form>
			</>
		)
	}
</AdminLayout>
