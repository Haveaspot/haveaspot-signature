---
import AdminLayout from '../../layouts/AdminLayout.astro';
import BarChart from '../../components/BarChart.astro';
import {
	analyticsSummary,
	analyticsDaily,
	analyticsBreakdown,
	analyticsTopStaff,
	analyticsCampaigns,
	impressionsTotal,
	totalClicks,
	totalImpressions,
	clicksOlderThan,
	impressionsOlderThan,
	deleteAnalytics,
} from '../../lib/admin-db';

export const prerender = false;

/**
 * Click analytics.
 *
 * The figures are derived from the `clicks` table, which stores a salted hash
 * of the IP rather than the address itself — so "visitors" is a count of
 * distinct hashes, good enough to separate ten opens by one person from ten
 * people, without holding anything identifying.
 *
 * The only write on this page is the delete at the bottom.
 */

const PERIODS = [7, 30, 90] as const;
const requested = Number(Astro.url.searchParams.get('days'));
const days = (PERIODS as readonly number[]).includes(requested) ? requested : 30;

/** The cutoff the retention delete uses. Fixed, not tied to the period switch:
 *  the switch changes what you are looking at, and a delete that quietly
 *  followed it would mean the same button removed a different span each time. */
const RETENTION_DAYS = 90;

let notice = '';
let deleteError = '';

if (Astro.request.method === 'POST') {
	try {
		const form = await Astro.request.formData();
		const scope = String(form.get('scope'));

		if (scope !== 'all' && scope !== 'older') throw new Error('Unknown delete scope.');

		// Typed confirmation, checked server-side as well as in the browser, so
		// the guard is not something a stray double-submit can skip.
		if (scope === 'all' && String(form.get('confirm')).trim().toUpperCase() !== 'DELETE') {
			throw new Error('Type DELETE to confirm clearing all analytics history.');
		}

		const removed = await deleteAnalytics(scope, RETENTION_DAYS);
		const n = (value: number) => value.toLocaleString('en-GB');
		notice =
			removed.clicks === 0 && removed.impressions === 0
				? 'Nothing to delete — there was no matching history.'
				: `Deleted ${n(removed.clicks)} click${removed.clicks === 1 ? '' : 's'} and ${n(removed.impressions)} impression${removed.impressions === 1 ? '' : 's'}.`;
	} catch (err) {
		deleteError = err instanceof Error ? err.message : String(err);
	}
}

let data: {
	summary: Awaited<ReturnType<typeof analyticsSummary>>;
	daily: Awaited<ReturnType<typeof analyticsDaily>>;
	assets: Awaited<ReturnType<typeof analyticsBreakdown>>;
	clients: Awaited<ReturnType<typeof analyticsBreakdown>>;
	devices: Awaited<ReturnType<typeof analyticsBreakdown>>;
	countries: Awaited<ReturnType<typeof analyticsBreakdown>>;
	staff: Awaited<ReturnType<typeof analyticsTopStaff>>;
	campaigns: Awaited<ReturnType<typeof analyticsCampaigns>>;
	views: number;
	total: number;
	stale: number;
} | null = null;
let loadError = '';

try {
	const [
		summary,
		daily,
		assets,
		clients,
		devices,
		countries,
		staff,
		campaigns,
		views,
		totalClickRows,
		totalViews,
		staleClicks,
		staleViews,
	] = await Promise.all([
			analyticsSummary(days),
			analyticsDaily(days),
			analyticsBreakdown('asset_type', days),
			analyticsBreakdown('email_client', days),
			analyticsBreakdown('device_type', days),
			analyticsBreakdown('country_code', days),
			analyticsTopStaff(days),
			analyticsCampaigns(days),
			impressionsTotal(days),
			totalClicks(),
			totalImpressions(),
			clicksOlderThan(RETENTION_DAYS),
			impressionsOlderThan(RETENTION_DAYS),
		]);
	// The delete controls talk about history as one thing, so the two tables are
	// summed for their counts rather than reported separately.
	data = {
		summary,
		daily,
		assets,
		clients,
		devices,
		countries,
		staff,
		campaigns,
		views,
		total: totalClickRows + totalViews,
		stale: staleClicks + staleViews,
	};
} catch (err) {
	loadError = err instanceof Error ? err.message : String(err);
}

/** Raw asset_type values are internal; these are what they mean. */
const ASSET_LABELS: Record<string, string> = {
	cta_default: 'Banner — default',
	cta_campaign: 'Banner — campaign',
	vcard: 'Save contact',
	website: 'Website icon',
	mail: 'Mail icon',
	linkedin: 'LinkedIn icon',
};

/**
 * Banner clicks only — not every click in the window.
 *
 * The rate has to divide banner clicks by banner views. Using the headline
 * click total would fold in icon and save-contact clicks, which have no
 * impressions behind them, and the tile would disagree with every row of the
 * banner table underneath it.
 */
const bannerClicks = (data?.campaigns ?? []).reduce((n, c) => n + c.clicks, 0);
const bannerViews = (data?.campaigns ?? []).reduce((n, c) => n + c.views, 0);

const regionNames = new Intl.DisplayNames(['en'], { type: 'region' });

function countryName(code: string): string {
	if (!code || code === '??' || code === 'UNKNOWN') return 'Unknown';
	try {
		return regionNames.of(code) ?? code;
	} catch {
		return code;
	}
}

function share(n: number, total: number): number {
	return total === 0 ? 0 : Math.round((n / total) * 100);
}

/**
 * Click-through rate, to one decimal place.
 *
 * Returns null rather than 0% when there are no views to divide by: a banner
 * nobody has been shown has no rate, and printing 0% would read as "shown and
 * ignored", which is a different and much worse story.
 *
 * A rate over 100% is possible and is not a bug. Gmail serves the banner from
 * its own cache shared across recipients, so one recorded view can cover many
 * people, any number of whom can click. Rather than capping the number — which
 * would quietly turn a signal about caching into a plausible-looking figure —
 * it is shown as it is, flagged, and explained on hover.
 */
function ctr(clicks: number, views: number): { label: string; overflowed: boolean } | null {
	if (views === 0) return null;
	const rate = (clicks / views) * 100;
	return { label: `${rate.toFixed(1)}%`, overflowed: rate > 100 };
}

const OVERFLOW_HINT =
	'More clicks than recorded views. Gmail serves the banner from a cache shared between recipients, so one view can stand for many people — the view count is a floor, which pushes this rate up.';
---

<AdminLayout
	title="Analytics"
	lede="Clicks from signatures already sitting in people's inboxes."
	section="analytics"
>
	<div slot="actions" class="period-switch">
		{
			PERIODS.map((p) => (
				<a href={`/admin/analytics?days=${p}`} class={p === days ? 'is-active' : ''}>
					{p} days
				</a>
			))
		}
	</div>

	{
		loadError ? (
			<section class="panel panel--error">
				<h2>Database unavailable</h2>
				<pre class="error-detail">{loadError}</pre>
			</section>
		) : !data ? null : (
			<>
				{notice && <p class="status status--ok">{notice}</p>}
				{deleteError && <p class="status status--error">{deleteError}</p>}

				<div class="stat-grid">
					<div class="stat">
						<span class="stat-value">{data.views.toLocaleString('en-GB')}</span>
						<span class="stat-label">Banner views</span>
					</div>
					<div class="stat">
						<span class="stat-value">{data.summary.clicks}</span>
						<span class="stat-label">Clicks</span>
					</div>
					<div class="stat">
						{(() => {
							const rate = ctr(bannerClicks, bannerViews);
							if (!rate) return <span class="stat-value">—</span>;
							return (
								<span class="stat-value" title={rate.overflowed ? OVERFLOW_HINT : undefined}>
									{rate.label}
									{rate.overflowed && <span class="stat-flag">?</span>}
								</span>
							);
						})()}
						<span class="stat-label">Banner click-through</span>
					</div>
					<div class="stat">
						<span class="stat-value">{data.summary.visitors}</span>
						<span class="stat-label">Distinct visitors</span>
					</div>
					<div class="stat">
						<span class="stat-value">{data.summary.staff}</span>
						<span class="stat-label">Staff with activity</span>
					</div>
				</div>

				{data.summary.clicks === 0 && data.views === 0 ? (
					<div class="table-wrap">
						<p class="empty">
							No clicks in the last {days} days. Clicks are recorded when someone follows a
							link in a signature — the banner, an icon, or the save-contact card.
						</p>
					</div>
				) : (
					<>
						<section style="margin-bottom:2.5rem">
							<h2>Clicks per day</h2>
							<BarChart points={data.daily} />
						</section>

						<div class="analytics-grid">
							<section>
								<h2>What was clicked</h2>
								<div class="table-wrap">
									<table class="data">
										<tbody>
											{
												data.assets.map((a) => (
													<tr>
														<td>{ASSET_LABELS[a.label] ?? a.label}</td>
														<td class="nowrap">{a.clicks}</td>
														<td class="bar-cell">
															<span class="bar" style={`width:${share(a.clicks, data.summary.clicks)}%`} />
														</td>
													</tr>
												))
											}
										</tbody>
									</table>
								</div>
							</section>

							<section>
								<h2>Banner performance</h2>
								{data.campaigns.length === 0 ? (
									<div class="table-wrap">
										<p class="empty">No banner activity yet.</p>
									</div>
								) : (
									<div class="table-wrap">
										<table class="data">
											<thead>
												<tr>
													<th>Banner</th>
													<th>Views</th>
													<th>Clicks</th>
													<th>Rate</th>
												</tr>
											</thead>
											<tbody>
												{
													data.campaigns.map((c) => (
														<tr>
															<td>{c.name}</td>
															<td class="nowrap">{c.views.toLocaleString('en-GB')}</td>
															<td class="nowrap">{c.clicks}</td>
															<td class="nowrap">
																{(() => {
																	const rate = ctr(c.clicks, c.views);
																	if (!rate) return <span class="muted">—</span>;
																	return (
																		<span title={rate.overflowed ? OVERFLOW_HINT : undefined}>
																			{rate.label}
																			{rate.overflowed && <span class="stat-flag">?</span>}
																		</span>
																	);
																})()}
															</td>
														</tr>
													))
												}
											</tbody>
										</table>
									</div>
								)}
								<p class="footnote">
									Campaigns listed against the default, so a campaign can be judged rather
									than just counted.
								</p>
							</section>

							<section>
								<h2>Mail client</h2>
								<div class="table-wrap">
									<table class="data">
										<tbody>
											{
												data.clients.map((c) => (
													<tr>
														<td>{c.label}</td>
														<td class="nowrap">{c.clicks}</td>
														<td class="bar-cell">
															<span class="bar" style={`width:${share(c.clicks, data.summary.clicks)}%`} />
														</td>
													</tr>
												))
											}
										</tbody>
									</table>
								</div>
								<p class="footnote">
									Guessed from the user agent. Gmail proxies image requests, so its share is
									approximate rather than exact.
								</p>
							</section>

							<section>
								<h2>Device</h2>
								<div class="table-wrap">
									<table class="data">
										<tbody>
											{
												data.devices.map((d) => (
													<tr>
														<td>{d.label}</td>
														<td class="nowrap">{d.clicks}</td>
														<td class="bar-cell">
															<span class="bar" style={`width:${share(d.clicks, data.summary.clicks)}%`} />
														</td>
													</tr>
												))
											}
										</tbody>
									</table>
								</div>
							</section>

							<section>
								<h2>Country</h2>
								<div class="table-wrap">
									<table class="data">
										<tbody>
											{
												data.countries.map((c) => (
													<tr>
														<td>{countryName(c.label)}</td>
														<td class="nowrap">{c.clicks}</td>
														<td class="bar-cell">
															<span class="bar" style={`width:${share(c.clicks, data.summary.clicks)}%`} />
														</td>
													</tr>
												))
											}
										</tbody>
									</table>
								</div>
							</section>

							<section>
								<h2>Most clicked signatures</h2>
								<div class="table-wrap">
									<table class="data">
										<thead>
											<tr>
												<th>Person</th>
												<th>Clicks</th>
											</tr>
										</thead>
										<tbody>
											{
												data.staff.map((s) => (
													<tr>
														<td>
															{s.id ? (
																<a href={`/admin/signatures/${s.id}`}>{s.name}</a>
															) : (
																<span title="No matching staff record — they may have been deleted">
																	{s.name}
																</span>
															)}
															<div class="muted">{s.email}</div>
														</td>
														<td class="nowrap">{s.clicks}</td>
													</tr>
												))
											}
										</tbody>
									</table>
								</div>
							</section>
						</div>
					</>
				)}

				<p class="footnote">
					Visitors are counted by a salted hash of the IP address — enough to tell ten opens by
					one person from ten people, without storing anything identifying. Dates are UK local.
				</p>
				<p class="footnote">
					<strong>Banner views are a floor, not a true count of opens.</strong> The banner image
					is cached for five minutes, and Gmail serves it through its own cache shared across
					recipients, so some opens never reach us. Views therefore under-count and the rate
					above over-states. Compare it against itself over time — the caching stays roughly
					constant, so a rate that doubles really has doubled — rather than against a published
					industry figure.
				</p>

				<section class="danger-zone">
					<h2>Delete analytics history</h2>
					<p class="footnote" style="margin-top:0">
						There is no undo and no backup. Clicks and banner views go together — deleting
						one without the other would leave a click-through rate whose top and bottom
						halves cover different spans of time. It also empties the click counts shown
						against staff and campaigns, because those are counted from this same history
						rather than stored separately. Signatures already in people's inboxes keep
						working and keep recording — this clears the record, not the tracking.
					</p>

					<div class="danger-action">
						<div>
							<strong>Clear history older than {RETENTION_DAYS} days</strong>
							<span class="hint">
								{data.stale === 0
									? 'Nothing is older than that yet.'
									: `${data.stale.toLocaleString('en-GB')} of ${data.total.toLocaleString('en-GB')} records would go. Recent activity is kept.`}
							</span>
						</div>
						<form method="POST" onsubmit={`return confirm('Delete ${data.stale} record${data.stale === 1 ? '' : 's'} older than ${RETENTION_DAYS} days? This cannot be undone.')`}>
							<input type="hidden" name="scope" value="older" />
							<button type="submit" class="btn btn--secondary btn--small" disabled={data.stale === 0}>
								Delete old records
							</button>
						</form>
					</div>

					<div class="danger-action">
						<div>
							<strong>Clear all analytics history</strong>
							<span class="hint">
								{data.total === 0
									? 'There is no history to delete.'
									: `All ${data.total.toLocaleString('en-GB')} records ever kept — clicks and banner views — not just the ${days} days shown above.`}
							</span>
						</div>
						<form method="POST" class="danger-confirm">
							<input type="hidden" name="scope" value="all" />
							<input
								type="text"
								name="confirm"
								placeholder="Type DELETE"
								autocomplete="off"
								aria-label="Type DELETE to confirm"
								disabled={data.total === 0}
							/>
							<button type="submit" class="btn btn--danger btn--small" disabled={data.total === 0}>
								Delete everything
							</button>
						</form>
					</div>
				</section>
			</>
		)
	}
</AdminLayout>
