---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
	listMedia,
	uploadMedia,
	deleteMedia,
	isConfigured,
	readDimensions,
	ratioNote,
	MAX_BYTES,
	MediaNotConfigured,
} from '../../lib/media';

export const prerender = false;

/**
 * Banner library.
 *
 * The WordPress original expected a URL you had already hosted elsewhere. This
 * replaces that: upload here, and the fields that take a banner offer what has
 * been uploaded rather than an empty box.
 */

let notice = '';
let error = '';
let warning = '';

if (Astro.request.method === 'POST') {
	try {
		const form = await Astro.request.formData();
		const action = String(form.get('action') ?? '');

		if (action === 'delete') {
			await deleteMedia(String(form.get('url') ?? ''));
			notice = 'Image deleted.';
		} else {
			const file = form.get('file');
			if (!(file instanceof File) || file.size === 0) {
				throw new Error('Choose a file to upload.');
			}

			// Read the header before storing, so the ratio warning is available
			// immediately rather than after someone sees a cropped signature.
			const dims = readDimensions(new Uint8Array(await file.arrayBuffer()));

			const { filename } = await uploadMedia(file);
			notice = `Uploaded ${filename}.`;

			if (dims) {
				const note = ratioNote(dims.width, dims.height);
				warning = note
					? `${dims.width}×${dims.height}. ${note} Banners work best at 3:1 — 1080×360.`
					: '';
			}
		}
	} catch (err) {
		error = err instanceof Error ? err.message : String(err);
	}
}

let media: Awaited<ReturnType<typeof listMedia>> = [];
let loadError = '';
const configured = isConfigured();

if (configured) {
	try {
		media = await listMedia();
	} catch (err) {
		loadError = err instanceof Error ? err.message : String(err);
	}
}

const sizeFmt = (bytes: number) =>
	bytes > 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${Math.round(bytes / 1024)} KB`;

const dateFmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium' });
---

<AdminLayout
	title="Banners"
	lede="Artwork for campaign banners. Upload here and it becomes selectable wherever a banner image is used."
	section="media"
>
	{
		!configured ? (
			<section class="panel panel--error">
				<h2>No blob store connected</h2>
				<p>Uploads need somewhere to go. This takes about a minute to set up:</p>
				<ol class="steps">
					<li>Vercel → <strong>Storage</strong> → <strong>Create</strong> → <strong>Blob</strong></li>
					<li>Connect it to the <code>haveaspot-signature</code> project</li>
					<li>Redeploy — environment variables only apply to builds made after they are added</li>
				</ol>
				<p class="footnote">
					That sets <code>BLOB_READ_WRITE_TOKEN</code> automatically. Until then, banner
					fields still accept a URL you host elsewhere, exactly as before.
				</p>
			</section>
		) : loadError ? (
			<section class="panel panel--error">
				<h2>Could not read the library</h2>
				<pre class="error-detail">{loadError}</pre>
			</section>
		) : (
			<>
				{notice && <p class="status status--ok">{notice}</p>}
				{warning && <p class="status status--warn">{warning}</p>}
				{error && <p class="status status--error">{error}</p>}

				<section class="panel" style="margin-bottom:2rem">
					<h2>Upload a banner</h2>
					<form method="POST" enctype="multipart/form-data" class="inline-form">
						<div class="field" style="margin:0; flex:1">
							<label for="file" class="sr-only">Image file</label>
							<input id="file" name="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" required />
						</div>
						<button type="submit" class="btn">Upload</button>
					</form>
					<p class="footnote">
						PNG, JPEG, WebP or GIF, up to {MAX_BYTES / 1024 / 1024}MB. Produce at <strong>3:1</strong> —
						1080×360 works well. Other ratios are cropped to fit rather than letterboxed, and
						you will be told if that applies.
					</p>
				</section>

				{media.length === 0 ? (
					<div class="table-wrap">
						<p class="empty">Nothing uploaded yet.</p>
					</div>
				) : (
					<div class="media-grid">
						{
							media.map((m) => (
								<figure class="media-item">
									<img src={m.url} alt={m.filename} loading="lazy" />
									<figcaption>
										<strong>{m.filename}</strong>
										<span class="hint">
											{sizeFmt(m.size)} · {dateFmt.format(m.uploadedAt)}
										</span>
										<div class="media-actions">
											<button
												type="button"
												class="btn btn--secondary btn--small copy-url"
												data-url={m.url}
											>
												Copy URL
											</button>
											<form
												method="POST"
												onsubmit={`return confirm('Delete ${m.filename}? Any campaign still pointing at it will lose its banner.')`}
											>
												<input type="hidden" name="action" value="delete" />
												<input type="hidden" name="url" value={m.url} />
												<button type="submit" class="btn btn--danger btn--small">Delete</button>
											</form>
										</div>
									</figcaption>
								</figure>
							))
						}
					</div>
				)}
			</>
		)
	}
</AdminLayout>

<script>
	// Copy-to-clipboard for pasting into a banner field by hand. The picker on
	// those fields is the normal route; this is for the occasional case where
	// someone wants the raw URL.
	document.querySelectorAll<HTMLButtonElement>('.copy-url').forEach((btn) => {
		btn.addEventListener('click', async () => {
			await navigator.clipboard.writeText(btn.dataset.url ?? '');
			const original = btn.textContent;
			btn.textContent = 'Copied';
			setTimeout(() => (btn.textContent = original), 2000);
		});
	});
</script>
