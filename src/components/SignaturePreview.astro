---
import { renderSignature, darkRulesCss } from '../lib/signature-html';
import type { SignatureFields } from '../lib/signature-html';
import type { CtaConfig } from '../lib/campaigns';
import type { Settings } from '../lib/settings';

interface Props {
	fields: SignatureFields;
	config: CtaConfig;
	settings: Settings;
	baseUrl: string;
}

const { fields, config, settings, baseUrl } = Astro.props;

/**
 * The whole signature exactly as this person's recipients see it right now.
 *
 * Built from `resolveCtaConfig`, not from the raw record, so it reflects the
 * resolved precedence chain — their own overrides on top of the global
 * settings, and a live campaign on top of both. Rendering the record directly
 * would show what is stored rather than what is sent, which is the thing worth
 * checking.
 *
 * The banner comes from `/api/cta` as usual, so what appears here is the same
 * artwork the mail client fetches rather than a reproduction of it.
 */
const html = renderSignature({ fields, config, settings, baseUrl });

/**
 * Which layer is actually winning, stated plainly. The chain is easy to reason
 * about wrongly — someone can set a personal override and be puzzled that a
 * campaign is overriding it — so the answer is given rather than implied.
 */
const source = config.disableCta
	? { label: 'No banner', detail: 'The banner is switched off for this person.' }
	: config.campaign
		? {
				label: `Campaign: ${config.campaign.name}`,
				detail: 'A live campaign is overriding both their own settings and the global default.',
			}
		: config.signature &&
			  (config.signature.cta_heading || config.signature.btn_text || config.signature.cta_link)
			? {
					label: 'Their own override',
					detail: 'Set on this page, taking precedence over the global default.',
				}
			: { label: 'Global default', detail: 'No override and no live campaign, so the settings apply.' };
---

<section class="sig-preview">
	<div class="sig-preview__head">
		<h2>How their signature looks now</h2>
		<span class="badge">{source.label}</span>
	</div>
	<p class="footnote" style="margin-top:0">{source.detail}</p>

	<div class="sig-preview__panes">
		<div class="sig-preview__pane">
			<span class="sig-preview__label">Light</span>
			<div class="sig-preview__stage" set:html={html} />
		</div>
		<div class="sig-preview__pane sig-preview__pane--dark force-dark">
			<span class="sig-preview__label">Dark</span>
			<div class="sig-preview__stage" set:html={html} />
		</div>
	</div>

	<p class="footnote">
		Shown side by side at reduced size — this is the real signature, not a mock-up, so what
		you see here is what lands in an inbox. Links are disabled: following one would log a
		click against this person and skew their analytics.
	</p>
</section>

<script>
	/**
	 * Scale each pane's signature down to fit beside its twin.
	 *
	 * The signature carries a 600px floor and cannot shrink — that floor is what
	 * stops the Gmail app truncating it, so it is not negotiable. Two panes on a
	 * 1180px page give roughly 500px each, so the real markup has to be scaled
	 * rather than reflowed.
	 *
	 * `zoom` rather than `transform: scale()`: zoom shrinks the space the element
	 * occupies, so the pane closes up around it. A transform would scale the
	 * pixels and leave the original height reserved, giving a tall empty gap
	 * under each signature.
	 *
	 * Measured rather than hard-coded, because the panes reflow with the window
	 * and a fixed ratio would be wrong at every width but one.
	 */
	const SIGNATURE_WIDTH = 600;

	function fit() {
		document.querySelectorAll<HTMLElement>('.sig-preview__stage').forEach((stage) => {
			const pane = stage.parentElement;
			if (!pane) return;
			// Reset first, so a re-measure after the window grows can scale back up
			// rather than only ever ratcheting down.
			stage.style.zoom = '1';
			const available = pane.clientWidth - 32; // the pane's 1rem padding either side
			stage.style.zoom = String(Math.min(1, available / SIGNATURE_WIDTH));
		});
	}

	fit();
	addEventListener('resize', fit);
	// The banner arrives after first paint and can change the pane's height; the
	// width is what matters here, but re-fitting on load costs nothing and covers
	// a pane that was still laying out when this first ran.
	addEventListener('load', fit);
</script>

<style is:global set:html={`
	/* The signature's own dark rules, forced on so the dark pane can be seen
	   without changing the operating system's appearance setting. Re-emitted from
	   the same source the signature uses, so this cannot drift from it. */
	${darkRulesCss('.force-dark ')}
`}></style>
