---
import type { MediaItem, MediaKind } from '../lib/media';
import { LOGO_SIZE, LOGO_SIZE_2X, PROMO_RATIO_LABEL, PROMO_ARTWORK_SIZE } from '../lib/media';

interface Props {
	name: string;
	value?: string;
	label?: string;
	media: MediaItem[];
	configured: boolean;
	/** Which library to offer, and which guidance to give. */
	kind?: MediaKind;
}

const {
	name,
	value = '',
	label = 'Promo banner image',
	media,
	configured,
	kind = 'banner',
} = Astro.props;

/**
 * An image field: choose from the library, or paste a URL.
 *
 * You are picking a picture, so the pictures are the control. This was a
 * `<select>` listing stored filenames — including the random suffix the blob
 * store appends so two people uploading `banner.png` do not overwrite each
 * other. That suffix is a storage detail that had no business in the
 * interface, and past three or four banners nobody could tell which was which.
 *
 * The URL box is still here, because the field has to keep working for artwork
 * hosted elsewhere and must not become unusable if the blob store is ever
 * disconnected. It is folded away instead of removed: it is the exception, and
 * it was previously the largest thing in the section, showing an unreadable
 * percent-encoded blob URL that nobody needs to read.
 *
 * Everything still submits a plain URL in one input, so nothing downstream
 * knows or cares where it came from.
 *
 * One component for banners and logos rather than two: the picker, the URL
 * fallback and the preview are identical, and only the shape and the advice
 * differ. Two copies of this would drift.
 */
const id = `${kind}-${name}`;
const isLogo = kind === 'logo';

/**
 * The name without the store's random suffix.
 *
 * `addRandomSuffix` appends a hyphen and a long alphanumeric run before the
 * extension. Matching only a run of 16 or more leaves ordinary hyphenated names
 * ("autumn-venues.png") alone; a name that genuinely ends in a long token is
 * possible but not worth guarding against, since this is display only — the
 * stored path is untouched.
 */
function displayName(filename: string): string {
	return filename.replace(/-[A-Za-z0-9]{16,}(\.[A-Za-z0-9]+)$/, '$1');
}

const hasLibrary = configured && media.length > 0;

/**
 * Whether the stored value points outside the library.
 *
 * Decides whether the URL row starts open: artwork hosted elsewhere has to be
 * visible and editable, while a library pick is already shown as a selected
 * thumbnail and needs no address on screen. Checking the scheme is not enough —
 * library URLs are `https://…` too.
 */
const isExternal = value !== '' && !media.some((m) => m.url === value);
---

<div class="field image-field" data-image-field>
	<span class="image-field__label">{label}</span>

	{
		hasLibrary && (
			<div class="image-picker" role="radiogroup" aria-label={`Choose an uploaded ${kind}`}>
				{media.map((m) => (
					<label class="image-choice">
						<input type="radio" name={`${id}-choice`} value={m.url} checked={m.url === value} />
						<img
							src={m.url}
							alt={displayName(m.filename)}
							loading="lazy"
							class={isLogo ? 'image-choice__art image-choice__art--logo' : 'image-choice__art'}
						/>
						<span class="image-choice__name">{displayName(m.filename)}</span>
					</label>
				))}
			</div>
		)
	}

	<div class="image-field__row">
		{
			hasLibrary && (
				<button type="button" class="btn btn--secondary btn--small" data-clear hidden>
					Clear
				</button>
			)
		}
		{
			/*
			 * Only offered when there is a library to choose instead. Without one
			 * the URL box is the whole control, and a toggle that hides it would be
			 * a way to make the field unusable.
			 */
			hasLibrary && (
				<button type="button" class="link-button" data-url-toggle>
					Paste a URL instead
				</button>
			)
		}
	</div>

	<!--
		Kept in the DOM rather than rendered conditionally: it is the one input
		that submits, so it has to exist whether or not the URL row is showing.
	-->
	<div class="image-field__url" data-url-row hidden={hasLibrary && !isExternal}>
		<label for={id} class="sr-only">{label} URL</label>
		<input id={id} name={name} type="url" value={value} placeholder="https://…" />
	</div>

	{
		/*
		 * Shown only when the URL points somewhere the picker cannot: artwork
		 * hosted elsewhere. A library image is already visible as its own
		 * thumbnail above, so previewing it again would be the same picture twice.
		 */
	}
	<img
		class={isLogo ? 'image-field__external image-field__external--logo' : 'image-field__external'}
		alt=""
		hidden
	/>

	<span class="hint">
		{
			hasLibrary
				? ''
				: configured
					? 'Nothing uploaded yet — '
					: ''
		}
		<a href={isLogo ? '/admin/media#logos' : '/admin/media'}>
			{configured ? (isLogo ? 'Manage logos' : 'Manage banners') : 'Set up uploads'}
		</a>.
		{
			isLogo ? (
				<>
					{' '}Produce at <strong>{LOGO_SIZE}</strong> ({LOGO_SIZE_2X} for retina), with the pill
					background baked into the image. Other ratios are squashed to fit, not cropped.
				</>
			) : (
				<>
					{' '}Produce at <strong>{PROMO_RATIO_LABEL}</strong> — {PROMO_ARTWORK_SIZE} works well.
					Other ratios are cropped.
				</>
			)
		}
	</span>
</div>

<script>
	// Wired per-field rather than globally, so several can sit on one page.
	document.querySelectorAll<HTMLElement>('[data-image-field]').forEach((field) => {
		const input = field.querySelector<HTMLInputElement>('input[type="url"]');
		const choices = [...field.querySelectorAll<HTMLInputElement>('.image-choice input')];
		const urlRow = field.querySelector<HTMLElement>('[data-url-row]');
		const urlToggle = field.querySelector<HTMLButtonElement>('[data-url-toggle]');
		const clearBtn = field.querySelector<HTMLButtonElement>('[data-clear]');
		const external = field.querySelector<HTMLImageElement>('.image-field__external');
		// urlToggle is absent when there is no library to toggle back to.
		if (!input || !urlRow || !external) return;

		const libraryUrls = new Set(choices.map((c) => c.value));

		/**
		 * Change the value the way a person typing would.
		 *
		 * Assigning to `input.value` in script fires no event, so anything else
		 * listening to the form never learns of it — and the live banner preview on
		 * these pages listens for `input`/`change`. Picking a thumbnail happened to
		 * work, because the radio's own change event bubbles to the form; pressing
		 * Clear did not, because a click is neither. The preview kept showing a
		 * banner that had just been removed.
		 *
		 * Dispatching here rather than relying on that means neither path depends
		 * on which listener happens to run first.
		 */
		function setValue(url: string) {
			input!.value = url;
			sync();
			input!.dispatchEvent(new Event('input', { bubbles: true }));
		}

		/**
		 * The URL input is the single source of truth — it is what submits.
		 * Everything else reflects it, so a value set by the picker, typed by hand,
		 * or restored on load all end in the same state.
		 */
		function sync() {
			const url = input!.value.trim();
			const fromLibrary = libraryUrls.has(url);

			choices.forEach((c) => {
				c.checked = c.value === url;
				c.closest('.image-choice')?.classList.toggle('is-selected', c.checked);
			});

			if (clearBtn) clearBtn.hidden = url === '';

			// Only preview artwork the picker cannot show. Guard the scheme: a
			// data: or javascript: value has no business being loaded, even on an
			// admin-only page.
			const showExternal = !fromLibrary && /^https?:\/\//i.test(url);
			external!.hidden = !showExternal;
			if (showExternal && external!.src !== url) external!.src = url;
		}

		choices.forEach((choice) =>
			choice.addEventListener('change', () => {
				if (!choice.checked) return;
				// Picking from the library supersedes a pasted URL, so fold the row
				// away again rather than leaving a stale address on screen.
				urlRow!.hidden = true;
				setValue(choice.value);
			}),
		);

		urlToggle?.addEventListener('click', () => {
			urlRow!.hidden = !urlRow!.hidden;
			if (!urlRow!.hidden) input!.focus();
		});

		clearBtn?.addEventListener('click', () => {
			urlRow!.hidden = true;
			setValue('');
		});

		input.addEventListener('input', sync);
		external.addEventListener('error', () => (external!.hidden = true));
		sync();
	});
</script>
